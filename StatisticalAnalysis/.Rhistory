geom_jitter(aes(color = as.factor(loop)), height = 0.1, width = 0, size = 2, alpha = 0.8) +
geom_point(data = mean_delay_df, aes(x = mean_delay),
color = "darkred", size = 3, shape = 16) +
geom_label(data = mean_delay_df,
aes(x = mean_delay, label = paste0("mean = ", round(mean_delay, 1))),
fill = "white", color = "black", label.r = unit(0.15, "lines"),
size = 3, label.padding = unit(0.05, "lines"), hjust = 0.5, nudge_y = 0.2) +
labs(
y = "Correct Activation\n(Reward == 1 and Activation == 1)",
x = "Delay after Grasp Type Change in Iterations",
