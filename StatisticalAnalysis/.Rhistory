# Experiment numbers
exp_numbers <- sprintf("%03d", 28:30)
exp_labels <- c("028" = "#1", "029" = "#2", "030" = "#3")
sheet_names <- c("reward_over_time", "activation_over_time")
# Base folder path
base_path <- "../Data/Experiments/02_Grasping"
loop_types <- c("PremotorLoop", "MotorLoop")
load_experiment_data <- function(exp_num, sheets, loop_types) {
exp_path <- file.path(base_path, exp_num)
# Search for both loop files
files <- map(loop_types, function(loop) {
file_path <- list.files(exp_path, pattern = paste0(loop, "\\.xlsx$"), full.names = TRUE)
file_path <- file_path[!grepl("~\\$", file_path)]  # skip temp Excel lock files
if (length(file_path) == 0) return(NULL)
file_path[1]
}) %>% set_names(loop_types)
# Read each file and sheet
exp_data <- map(files, function(file) {
if (is.null(file)) return(NULL)
tryCatch({
data <- map(sheets, function(sheet) {
df <- read_excel(file, sheet = sheet)
if (!"time" %in% names(df)) return(NULL)
df <- df %>% mutate(iteration = time / 100)
df
})
names(data) <- sheets
data
}, error = function(e) {
warning(paste("Skipping unreadable file:", file))
NULL
})
})
exp_data
}
experiments <- set_names(
map(exp_numbers, ~ load_experiment_data(.x, sheet_names, loop_types)),
exp_numbers
)
extract_sheet_data <- function(experiments, sheet_name) {
map_dfr(names(experiments), function(exp_num) {
exp <- experiments[[exp_num]]
if (is.null(exp)) return(NULL)
map_dfr(names(exp), function(loop_name) {
loop_data <- exp[[loop_name]]
if (is.null(loop_data)) return(NULL)
df <- loop_data[[sheet_name]]
if (is.null(df)) return(NULL)
df %>%
pivot_longer(
cols = -c(time, iteration),
names_to = "variable",
values_to = "value"
) %>%
mutate(
experiment = exp_num,
loop = loop_name,
sheet = sheet_name
)
})
})
}
all_data <- map_dfr(sheet_names, extract_sheet_data, experiments = experiments)
all_data <- all_data %>%
mutate(
sheet_clean = sheet %>%
str_remove("_over_time$") %>%
str_replace_all("_", " ") %>%
str_to_title(),
loop_clean = factor(loop,
levels = c("PremotorLoop", "MotorLoop"),
labels = c("Premotor\nLoop", "Motor\nLoop")),
loop_sheet = paste(loop_clean, sheet_clean, sep = " | ")
)
loop_sheet_labels <- c(
"Premotor Loop | Reward" = "Premotor\nLoop\nReward",
"Premotor Loop | Activation" = "Premotor\nLoop\nActivation",
"Motor Loop | Reward" = "Motor\nLoop\nReward",
"Motor Loop | Activation" = "Motor\nLoop\nActivation"
)
transitions <- c(10, 20)
#vline_data <- tibble(xintercept = transitions, linetype = "Grasp Type Change")
all_data <- all_data %>%
mutate(
sheet_clean = factor(sheet_clean, levels = c("Reward", "Activation"))
)
all_data <- all_data %>%
group_by(variable) %>%                 # group by each variable
filter(any(value != 0, na.rm = TRUE)) %>%  # keep only variables with at least one non-zero value
ungroup()
premotor_reward <- all_data %>%
filter(loop_clean == "Premotor\nLoop", sheet_clean == "Reward") %>%
mutate(variable = droplevels(factor(variable, levels = c("100", "010", "001"))))
premotor_activation <- all_data %>%
filter(loop_clean == "Premotor\nLoop", sheet_clean == "Activation") %>%
mutate(variable = droplevels(factor(variable, levels = c("1110", "1111", "0110"))))
motor_reward <- all_data %>%
filter(loop_clean == "Motor\nLoop", sheet_clean == "Reward") %>%
mutate(variable = droplevels(factor(variable, levels = c("1110", "1111", "0110"))))
motor_activation <- all_data %>%
filter(loop_clean == "Motor\nLoop", sheet_clean == "Activation") %>%
mutate(variable = droplevels(factor(variable, levels = c("1110", "1111", "0110"))))
delay_regions <- activation_reward_delays %>%
mutate(
xstart = transition_iter,
xend   = first_joint_iter,
ystart = -Inf,
yend   = Inf
)
ggplot(all_data, aes(x = iteration, y = value, group = variable)) +
geom_rect(
data = delay_regions,
aes(xmin = xstart, xmax = xend, ymin = ystart, ymax = yend, fill = "Delay Period"),
inherit.aes = FALSE,
alpha = 0.3
) +
scale_fill_manual(
name = "",
values = c("Delay Period" = "grey70")
) +
geom_line(
data = premotor_reward,
aes(color = variable),
size = 1,
alpha = 0.8
) +
scale_color_viridis_d(
name = "Premotor Loop\nGoals",
option = "D",
) +
guides(
color = guide_legend(order = 1)
) +
ggnewscale::new_scale_color() +
geom_line(
data = motor_reward,
aes(color = variable),
size = 1,
alpha = 0.8
) +
scale_color_viridis_d(
name = "Motor Loop\nGoals",
option = "D",
) +
guides(
color = guide_legend(order = 2)
) +
geom_line(
data = premotor_activation,
aes(color = variable),
size = 1,
alpha = 0.8,
show.legend = FALSE
) +
geom_line(
data = motor_activation,
aes(color = variable),
size = 1,
alpha = 0.8,
show.legend = FALSE
) +
geom_vline(xintercept = transitions, linetype="dashed", color = "black", size = 0.5) +
scale_linetype_manual(name = "", values = c("Grasp Type Change" = "dashed")) +
scale_y_continuous(
breaks = c(0, 1)
) +
facet_grid(loop_clean + sheet_clean ~ experiment,
labeller = labeller(experiment = exp_labels, loop_sheet = loop_sheet_labels)) +
labs(x = "Iteration", y = "Value") +
theme_minimal(base_size = 14) +
theme(
strip.text.y = element_text(angle = -90, hjust = 0),
legend.position = "right",
)
delay_regions <- activation_reward_delays %>%
mutate(
